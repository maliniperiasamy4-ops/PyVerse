#Electricity Bill Calculator
unit=int(input())
if unit<=50:
  bill=unit
elif unit<=150:
  bill=50+(unit-50)*2
elif unit<=250:
  bill=250+(unit-150)*3
else:  
  bill=550+(unit-250)*4
if bill>150:
  bill*= 1.2
if bill.is_integer():
  print(int(bill))
else:
  print(bill)

